{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taita-socal-website",
  "compatibility_date": "2026-08-11",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL"
    }
  ]
}
